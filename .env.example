# Supabase (project DalilPi). The key is the publishable/anon key; it is only used on the server.
SUPABASE_URL=
SUPABASE_KEY=
# Random secret whose sha256 is stored in ln_config('server_secret_sha256').
LN_DB_SECRET=
# Random secret that signs login cookies and price quotes.
SESSION_SECRET=
# Pi Developer Portal -> your app -> API Key.
PI_API_KEY=
# Meta Model API key (starts with LLM_).
META_API_KEY=
META_MODEL=muse-ember-1.0
# Comma-separated Pi usernames that become admins on login.
ADMIN_USERNAMES=
